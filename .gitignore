# ============================================================
# Night Shift — Unity .gitignore
# ============================================================

# ——— Unity generated ———
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/_[Rr]ecovery/

# ——— Asset metadata (keep .meta files, exclude asset imports) ———
!/[Aa]ssets/**/*.meta

# ——— IDE / editor ———
.vs/
.vscode/
.idea/
.claude/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ——— OS junk ———
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# ——— Builds & packages ———
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
!Assets/Plugins/**/*.dll

# ——— Crash reports & Logs ———
crashlytics-build.properties
sysinfo.txt
mono_crash.*
/CrashReporter/
*.log

# ——— Addressables ———
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ——— Plastic SCM (if used) ———
*.private.0
*.private
ignore.conf

# ——— TextMeshPro (regenerable) ———
/[Aa]ssets/TextMesh Pro/

# ——— NuGet ———
NuGet.config

# ——— Gradle (Android builds) ———
/[Aa]ssets/Plugins/Android/mainTemplate.gradle.bak
/[Aa]ssets/Plugins/Android/launcherTemplate.gradle.bak
baseProjectTemplate.gradle.bak
gradleTemplate.properties.bak
launcherTemplate.gradle.bak
mainTemplate.gradle.bak
*.gradle.bak

# ——— Code coverage ———
/[Cc]ode[Cc]overage/

# ——— Annotation cache ———
/[Aa]ssets/[Ss]criptable[Oo]bjects~

# ——— Rider ———
.idea/
*.DotSettings.user
